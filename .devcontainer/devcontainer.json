{
  "name": "PlotSystem",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "forwardPorts": [3000, 5001],
  "portsAttributes": {
    "3000": {
      "label": "PlotSystem Frontend",
      "onAutoForward": "openPreview",
      "visibility": "private"
    },
    "5001": {
      "label": "PlotSystem API",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "uv sync --extra dev && npm install && (cd frontend && if [ -f package-lock.json ]; then npm ci; else npm install; fi)",
  "postStartCommand": "if [ -n \"$LLM_API_KEY\" ] && [ ! -f .env ]; then cp .env.example .env && sed -i \"s|^LLM_API_KEY=.*|LLM_API_KEY=$LLM_API_KEY|\" .env; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Vue.volar",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
